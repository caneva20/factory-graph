{
  "name": "single-node",
  "description": "One machine group converts an external input into a targeted output.",
  "dimensions": {
    "graphShape": "single-node",
    "constraints": ["target"],
    "resourceConditions": ["unlimited-supply", "balanced-output"]
  },
  "request": {
    "graph": {
      "items": [
        { "id": "ore", "name": "Ore" },
        { "id": "plate", "name": "Plate" }
      ],
      "recipes": [
        {
          "id": "smelt",
          "name": "Smelt",
          "inputs": [{ "itemId": "ore", "amount": 1 }],
          "outputs": [{ "itemId": "plate", "amount": 1 }]
        }
      ],
      "machineGroups": [
        {
          "id": "11111111-1111-1111-1111-111111111111",
          "recipeId": "smelt",
          "activityRatePerMachine": 2,
          "availableMachineCount": null,
          "activityCapacity": null
        }
      ],
      "connections": [],
      "supplies": [
        {
          "id": "22222222-2222-2222-2222-222222222222",
