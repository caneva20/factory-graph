          "itemId": "ore",
          "capacity": null
        }
      ],
      "productOutlets": [
        {
          "id": "33333333-3333-3333-3333-333333333333",
          "sourceMachineGroupId": "11111111-1111-1111-1111-111111111111",
          "itemId": "plate",
          "capacity": null
        }
      ],
      "surplusOutlets": []
    },
    "targets": [
      {
        "id": "44444444-4444-4444-4444-444444444444",
        "productOutletIds": ["33333333-3333-3333-3333-333333333333"],
        "rate": "${rate}"
      }
    ],
    "mode": "targetDriven",
    "objective": "meetTargetsMinimizeExternalSupply",
    "options": {
      "numericPolicy": {
        "absoluteTolerance": 0.000001,
        "relativeTolerance": 0.000001,
        "nearZeroThreshold": 0.000000001
      },
      "timeLimit": null
    }
  },
  "expected": {
